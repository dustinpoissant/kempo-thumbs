{
  "name": "kempo-thumbs",
  "version": "0.1.3",
  "description": "Automatic thumbnail generation for kempo-files — ffmpeg-backed, for images, video and audio",
  "license": "MIT",
  "author": "Dustin Poissant",
  "type": "module",
  "main": "sdk.js",
  "scripts": {
    "test": "kempo-test -l minimal",
    "link:local": "npm install ../kempo ../kempo-files ../kempo-server ../kempo-ui --no-save --no-legacy-peer-deps --force"
  },
  "kempo": {
    "public-scope": "kempo-thumbs"
  },
  "exports": {
    "./uninstall": "./uninstall.js",
    "./sdk": "./sdk.js"
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/dustinpoissant/kempo-thumbs.git"
  },
  "dependencies": {
    "@ffprobe-installer/ffprobe": "^2.1.2",
    "drizzle-orm": "^0.45.2",
    "ffmpeg-static": "^5.3.0"
  },
  "peerDependencies": {
    "kempo": ">=4.2.39",
    "kempo-files": ">=0.1.3",
    "kempo-server": ">=3.3.0",
    "kempo-ui": ">=0.4.53"
  },
  "devDependencies": {
    "drizzle-kit": "^0.31.10",
    "kempo-testing-framework": "^1.4.11",
    "postgres": "^3.4.9"
  },
  "allowScripts": {
    "@ffprobe-installer/darwin-arm64@5.0.1": true,
    "@ffprobe-installer/darwin-x64@5.1.0": true,
    "@ffprobe-installer/linux-arm@5.2.0": true,
    "@ffprobe-installer/linux-arm64@5.2.0": true,
    "@ffprobe-installer/linux-ia32@5.2.0": true,
    "@ffprobe-installer/linux-x64@5.2.0": true,
    "esbuild@0.18.20": true,
    "esbuild@0.25.12": true,
    "esbuild@0.28.2": true,
    "ffmpeg-static@5.3.0": true,
    "puppeteer@25.7.0": true
  }
}
